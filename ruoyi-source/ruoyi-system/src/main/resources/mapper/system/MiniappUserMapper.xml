<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MiniappUserMapper">

    <resultMap type="MiniappUser" id="MiniappUserResult">
        <result property="userId"        column="user_id"        />
        <result property="miniappId"     column="miniapp_id"     />
        <result property="openid"        column="openid"          />
        <result property="wxId"          column="wx_id"           />
        <result property="nickname"      column="nickname"        />
        <result property="isMember"      column="is_member"       />
        <result property="memberExpire"  column="member_expire"   />
        <result property="status"        column="status"          />
        <result property="createTime"    column="create_time"     />
        <result property="updateTime"    column="update_time"     />
        <result property="remark"        column="remark"           />
    </resultMap>

    <sql id="selectMiniappUserVo">
        select user_id, miniapp_id, openid, wx_id, nickname, is_member, member_expire, status, create_time, update_time, remark
        from miniapp_user
    </sql>

    <select id="selectByMiniappAndOpenid" resultMap="MiniappUserResult">
        <include refid="selectMiniappUserVo"/>
        where miniapp_id = #{miniappId} and openid = #{openid}
    </select>

    <select id="selectMiniappUserList" parameterType="MiniappUser" resultMap="MiniappUserResult">
        <include refid="selectMiniappUserVo"/>
        <where>
            <if test="miniappId != null and miniappId != ''"> and miniapp_id = #{miniappId} </if>
            <if test="openid != null and openid != ''"> and openid like concat('%', #{openid}, '%') </if>
            <if test="wxId != null and wxId != ''"> and wx_id like concat('%', #{wxId}, '%') </if>
            <if test="nickname != null and nickname != ''"> and nickname like concat('%', #{nickname}, '%') </if>
            <if test="isMember != null"> and is_member = #{isMember} </if>
            <if test="status != null and status != ''"> and status = #{status} </if>
        </where>
        order by user_id desc
    </select>

    <select id="selectMiniappUserById" parameterType="Long" resultMap="MiniappUserResult">
        <include refid="selectMiniappUserVo"/>
        where user_id = #{userId}
    </select>

    <insert id="insertMiniappUser" parameterType="MiniappUser" useGeneratedKeys="true" keyProperty="userId">
        insert into miniapp_user(
            <trim suffixOverrides=",">
                miniapp_id,
                openid,
                wx_id,
                <if test="nickname != null">nickname,</if>
                is_member,
                <if test="memberExpire != null">member_expire,</if>
                status,
                create_time,
                update_time,
                <if test="remark != null">remark,</if>
            </trim>
        )values(
            <trim suffixOverrides=",">
                #{miniappId},
                #{openid},
                #{wxId},
                <if test="nickname != null">#{nickname},</if>
                #{isMember},
                <if test="memberExpire != null">#{memberExpire},</if>
                #{status},
                sysdate(),
                sysdate(),
                <if test="remark != null">#{remark},</if>
            </trim>
        )
    </insert>

    <update id="updateMiniappUser" parameterType="MiniappUser">
        update miniapp_user
        <trim prefix="set" suffixOverrides=",">
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="isMember != null">is_member = #{isMember},</if>
            <if test="memberExpire != null">member_expire = #{memberExpire},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where user_id = #{userId}
    </update>

    <update id="updateMemberStatus" parameterType="MiniappUser">
        update miniapp_user set
            is_member = #{isMember},
            <if test="memberExpire != null">member_expire = #{memberExpire},</if>
            update_time = sysdate()
        where user_id = #{userId}
    </update>

</mapper>
