# 若依 Docker 部署环境变量
# 用法: cp .env.example .env 然后修改下面的值
# 注意: .env 不要提交到 git(已在 .gitignore 里)

# ===== MySQL 配置 =====
# root 密码,生产环境务必改成强密码
MYSQL_ROOT_PASSWORD=ChangeMe_StrongPwd_2026
# 数据库名(若依默认 ry)
MYSQL_DATABASE=ry

# ===== Redis 配置 =====
# Redis 密码,生产环境务必改
REDIS_PASSWORD=ChangeMe_RedisPwd_2026

# ===== 域名(用于 SSL 证书申请) =====
# 没有域名时先用 IP 访问,这行先留着
DOMAIN=your-domain.com

# ===== 后端应用配置(可选,若依 application.yml 也可直接改) =====
# 这些变量会传给 ruoyi-admin 容器,在 application.yml 里可用 ${DB_HOST} 等引用
# 若依默认 application.yml 是写死的,如果不想改 yml,这里填了也没用
# 推荐做法: 直接改 ruoyi-admin 源码的 application.yml,把连接信息写死
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ry
DB_USER=root
DB_PASSWORD=ChangeMe_StrongPwd_2026
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_RedisPwd_2026
